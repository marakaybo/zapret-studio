{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zapret Studio",
  "version": "1.2.0",
  "identifier": "com.marakabo.zapret-studio",
  "build": {
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zapret Studio",
        "width": 1120,
        "height": 740,
        "minWidth": 940,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Russian", "English"]
      }
    }
  }
}
